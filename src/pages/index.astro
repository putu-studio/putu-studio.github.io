---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../site.config';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.title, url: SITE.url };
---
<Base jsonLd={jsonLd}>
  <section class="intro">
    <h1>Putu Studio</h1>
    <p class="lead">We build devices that aim to solve everyday problems, and we open-source everything so you can build it and use it yourself.</p>
    <p>Open a project to see how it works, what it's made from, and how to build your own.</p>
  </section>

  <h2>Projects</h2>
  <ProjectList projects={projects} />

  {posts.length > 0 && (<>
    <h2>Blog</h2>
    <PostList posts={posts} />
  </>)}

  <h2>Source code</h2>
  <p>All firmware, build steps and documentation are on <a href={SITE.github}>GitHub</a>. Issues and pull requests are welcome.</p>
</Base>
<style>
  .intro { padding: 20px 0 8px; }
  .intro h1 { font-size: 2.6rem; }
</style>
