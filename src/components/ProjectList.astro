---
import type { CollectionEntry } from 'astro:content';
import { statusLabel } from '../status';
interface Props { projects: CollectionEntry<'projects'>[]; showTech?: boolean; }
const { projects, showTech = false } = Astro.props;
---
<div class="projects">
  {projects.map((p) => (
    <a class="project" href={`/projects/${p.id}/`}>
      <div class="thumb">
        {p.data.cover
          ? <img src={p.data.cover} alt={p.data.coverAlt ?? ''} loading="lazy" />
          : <span>photo coming soon</span>}
      </div>
      <div class="text">
        <p class="status">{statusLabel(p.data)}</p>
        <h3>{p.data.title}</h3>
        <p class="sum">{p.data.summary}</p>
        {showTech && <p class="tech">{p.data.tags.join(' · ')}</p>}
      </div>
    </a>
  ))}
</div>
<style>
  .projects { display: grid; gap: 18px; margin: 1em 0 0.5em; }
  .project {
    display: grid; grid-template-columns: 190px 1fr; gap: 22px; align-items: start;
    padding: 18px; border-radius: 12px; border: 1px solid var(--rule); background: var(--surface);
    color: inherit; text-decoration: none; transition: border-color 0.15s, transform 0.15s;
  }
  .project:hover { border-color: var(--accent); transform: translateY(-1px); }
  .thumb { aspect-ratio: 4 / 3; border-radius: 8px; overflow: hidden; background: var(--code-bg); display: grid; place-items: center; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb span { font-family: var(--font-ui); font-size: 0.75rem; color: var(--muted); }
  .text p { margin: 0; }
  .status { font-family: var(--font-ui); font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); }
  h3 { margin: 4px 0 6px; font-size: 1.2rem; }
  .sum { font-size: 1rem; line-height: 1.6; }
  .tech { margin-top: 10px !important; font-family: var(--font-ui); font-size: 0.78rem; color: var(--muted); }
  @media (max-width: 560px) { .project { grid-template-columns: 1fr; gap: 14px; } }
</style>
