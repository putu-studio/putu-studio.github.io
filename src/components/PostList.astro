---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<ul class="posts">
  {posts.map((post) => (
    <li>
      <a class="thumb" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
        {post.data.cover
          ? <img src={post.data.cover} alt="" loading="lazy" />
          : <span>photo coming soon</span>}
      </a>
      <div>
        <a class="title" href={`/blog/${post.id}/`}>{post.data.title}</a>
        <span class="date">{fmt(post.data.date)}</span>
        <p>{post.data.description}</p>
      </div>
    </li>
  ))}
</ul>
<style>
  .posts { list-style: none; padding: 0; margin: 0; }
  .posts li { display: grid; grid-template-columns: 150px 1fr; gap: 18px; align-items: start; padding: 16px 0; border-bottom: 1px solid var(--rule); }
  .posts li:first-child { padding-top: 4px; }
  .thumb { aspect-ratio: 4 / 3; border-radius: 8px; overflow: hidden; background: var(--code-bg); display: grid; place-items: center; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .thumb span { font-family: var(--font-ui); font-size: 0.72rem; color: var(--muted); }
  .posts .title { font-family: var(--font-ui); font-weight: 600; font-size: 1.02rem; text-decoration: none; color: var(--text); }
  .posts .title:hover { color: var(--accent); }
  .date { font-family: var(--font-ui); font-size: 0.8rem; color: var(--muted); margin-left: 10px; white-space: nowrap; }
  .posts p { margin: 4px 0 0; font-size: 0.95rem; color: var(--muted); line-height: 1.55; }
  @media (max-width: 560px) { .posts li { grid-template-columns: 1fr; gap: 10px; } }
</style>
